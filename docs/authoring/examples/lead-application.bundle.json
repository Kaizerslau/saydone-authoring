{
  "bundleVersion": 1,
  "artifacts": {
    "botSpec": {
      "specVersion": 1,
      "bot": { "name": "Заявка на услугу", "defaultLocale": "ru" },
      "assets": { "service_banner": { "kind": "image", "required": true } },
      "content": {
        "menu": { "format": "telegram_html", "text": "<b>Выберите услугу</b>", "variables": { "required": [], "optional": [] }, "asset": "service_banner" },
        "help": { "format": "plain", "text": "Выберите услугу или продолжите анкету.", "variables": { "required": [], "optional": [] } },
        "summary": { "format": "telegram_markdown_v2", "text": "Услуга {{selected_service}} Статус {{qualification}} Телефон {{contact_phone}}", "variables": { "required": ["selected_service", "qualification", "contact_phone"], "optional": ["crm_application_id"] } }
      },
      "httpResources": {
        "crm_submit": {
          "endpoint": "https://crm.example.test/v1/applications",
          "method": "POST",
          "idempotency": "provider_key",
          "credential": { "reference": "crm_application_credential", "mode": "bearer" },
          "headers": { "accept": "application/json" },
          "request": { "body": [{ "name": "service", "field": "selected_service" }, { "name": "phone", "field": "contact_phone" }] },
          "response": { "contentType": "application/json", "mappings": [{ "path": "/application/id", "field": "crm_application_id", "type": "text" }] }
        }
      },
      "ruleSets": {
        "qualification": {
          "mode": "first_match",
          "resultField": "qualification",
          "rules": [{ "key": "adult", "when": { "field": "age_next_year", "op": "greaterOrEqual", "value": 18 }, "value": "qualified" }],
          "otherwise": { "type": "value", "value": "review" }
        }
      },
      "entry": "menu",
      "startPayloads": { "promo": "menu" },
      "blocks": {
        "menu": {
          "actions": [{ "type": "send", "content": "menu", "buttons": [
            { "text": "Консультация", "action": { "type": "choice", "key": "consultation", "run": "service_selected", "save": "selected_service" }, "aliases": ["консультация"] },
            { "text": "Условия", "action": { "type": "url", "url": "https://club.example/terms" } }
          ] }],
          "on": [{ "command": "help", "run": "help" }],
          "fallback": { "run": "fallback" }
        },
        "service_selected": { "actions": [{ "type": "send", "text": "Напишите continue, чтобы начать анкету" }], "on": [{ "text": { "equalsAny": ["continue"], "trim": true, "ignoreCase": true }, "run": "profile_call" }] },
        "profile_call": { "call": { "subflow": "qualify_service", "then": "contact" } },
        "contact": {
          "actions": [{ "type": "send", "text": "Поделитесь контактом", "buttons": [{ "text": "Контакт", "action": { "type": "request_contact" } }] }],
          "input": { "type": "telegram_contact", "save": "contact_phone", "run": "summary" }
        },
        "summary": {
          "actions": [{ "type": "send", "content": "summary" }, { "type": "call", "operation": "HTTP_REQUEST", "input": { "resourceKey": "crm_submit" } }],
          "on": [
            { "text": { "equalsAny": ["confirm"], "trim": true, "ignoreCase": true }, "run": "confirmed" },
            { "text": { "equalsAny": ["review"], "trim": true, "ignoreCase": true }, "when": { "field": "qualification", "op": "equals", "value": "review" }, "run": "review" }
          ]
        },
        "confirmed": { "actions": [{ "type": "send", "text": "Заявка подтверждена" }] },
        "review": { "actions": [{ "type": "send", "text": "Заявка передана на проверку" }] },
        "help": { "actions": [{ "type": "send", "content": "help" }] },
        "fallback": { "actions": [{ "type": "send", "text": "Не понял запрос" }] }
      },
      "subflows": {
        "qualify_service": {
          "inputs": ["selected_service"],
          "outputs": ["age", "age_next_year", "qualification"],
          "entry": "ask_age",
          "result": "done",
          "blocks": {
            "ask_age": {
              "actions": [{ "type": "send", "text": "Сколько вам лет?" }],
              "input": { "type": "number", "save": "age", "run": "age_gate", "invalid": { "run": "retry", "maxAttempts": 2, "exhaustedRun": "exhausted" }, "timeout": { "after": "5m", "run": "timed_out" } },
              "on": [{ "text": { "equalsAny": ["help"], "trim": true, "ignoreCase": true }, "run": "retry" }]
            },
            "retry": { "saveState": false, "actions": [{ "type": "send", "text": "Введите число" }], "next": "ask_age" },
            "exhausted": { "actions": [{ "type": "send", "text": "Попытки исчерпаны" }] },
            "timed_out": { "actions": [{ "type": "send", "text": "Время анкеты истекло" }] },
            "age_gate": { "actions": [{ "type": "send", "text": "Напишите continue для оценки" }], "on": [{ "text": { "equalsAny": ["continue"], "trim": true, "ignoreCase": true }, "when": { "field": "age", "op": "greaterOrEqual", "value": 0 }, "run": "calculate" }] },
            "calculate": { "saveState": false, "actions": [{ "type": "set", "values": { "age_next_year": { "$transform": { "operation": "add", "args": [{ "$from": "age" }, 1] } } } }], "next": "classify" },
            "classify": { "saveState": false, "actions": [{ "type": "applyRuleSet", "ruleSet": "qualification" }], "next": "done" },
            "done": {}
          }
        }
      }
    },
    "dataFields": {
      "dataFieldCatalogVersion": 1,
      "fields": [
        { "key": "selected_service", "label": "Услуга", "scope": "user", "type": "text", "allowedValues": ["consultation"], "visibility": "standard" },
        { "key": "age", "label": "Возраст", "scope": "flow", "type": "number", "min": 0, "max": 120, "visibility": "standard" },
        { "key": "age_next_year", "label": "Возраст в следующем году", "scope": "flow", "type": "number", "min": 1, "max": 121, "visibility": "technical" },
        { "key": "qualification", "label": "Результат квалификации", "scope": "flow", "type": "text", "allowedValues": ["qualified", "review"], "visibility": "standard" },
        { "key": "contact_phone", "label": "Телефон", "scope": "user", "type": "text", "format": "phone", "visibility": "standard" },
        { "key": "crm_application_id", "label": "CRM заявка", "scope": "user", "type": "text", "visibility": "technical" }
      ]
    },
    "acceptance": {
      "acceptanceVersion": 1,
      "scenarios": [
        {
          "key": "qualified_application",
          "description": "Static service choice, Subflow, typed input, transform, RuleSet, contact and CRM resource compose.",
          "steps": [
            { "type": "start", "payload": "promo" }, { "type": "processEffects" },
            { "type": "button", "block": "menu", "actionIndex": 0, "buttonIndex": 0 }, { "type": "expectBlock", "block": "service_selected" }, { "type": "processEffects" },
            { "type": "text", "text": "continue" }, { "type": "expectBlock", "subflow": "qualify_service", "block": "ask_age" }, { "type": "processEffects" },
            { "type": "text", "text": "20" }, { "type": "expectBlock", "subflow": "qualify_service", "block": "age_gate" }, { "type": "text", "text": "continue" }, { "type": "expectBlock", "block": "contact" }, { "type": "processEffects" },
            { "type": "contact", "phone": "+79991234567" }, { "type": "expectBlock", "block": "summary" }, { "type": "processEffects" },
            { "type": "text", "text": "confirm" }, { "type": "expectBlock", "block": "confirmed" }, { "type": "processEffects" }, { "type": "expectNoPendingWork" }
          ]
        },
        {
          "key": "ruleset_default_review",
          "description": "RuleSet otherwise result takes the later fallback path.",
          "steps": [
            { "type": "start" }, { "type": "processEffects" }, { "type": "button", "block": "menu", "actionIndex": 0, "buttonIndex": 0 }, { "type": "text", "text": "continue" },
            { "type": "text", "text": "16" }, { "type": "expectBlock", "subflow": "qualify_service", "block": "age_gate" }, { "type": "text", "text": "continue" }, { "type": "expectBlock", "block": "contact" }, { "type": "processEffects" },
            { "type": "contact", "phone": "+79997654321" }, { "type": "expectBlock", "block": "summary" }, { "type": "processEffects" },
            { "type": "text", "text": "review" }, { "type": "expectBlock", "block": "review" }, { "type": "processEffects" }, { "type": "expectNoPendingWork" }
          ]
        },
        {
          "key": "command_specific_text_and_fallback",
          "description": "Command, specific text before generic input and unmatched fallback stay bounded.",
          "steps": [
            { "type": "start" }, { "type": "command", "command": "help" }, { "type": "expectBlock", "block": "help" }, { "type": "processEffects" }, { "type": "expectNoPendingWork" }
          ]
        },
        {
          "key": "unmatched_fallback",
          "description": "Unmatched ordinary text uses the explicit state fallback.",
          "steps": [{ "type": "start" }, { "type": "text", "text": "unknown" }, { "type": "expectBlock", "block": "fallback" }, { "type": "processEffects" }, { "type": "expectNoPendingWork" }]
        },
        {
          "key": "input_retry_timeout",
          "description": "Specific text route and timeout are bounded inside the static Subflow.",
          "steps": [
            { "type": "start" }, { "type": "button", "block": "menu", "actionIndex": 0, "buttonIndex": 0 }, { "type": "text", "text": "continue" }, { "type": "expectBlock", "subflow": "qualify_service", "block": "ask_age" }, { "type": "processEffects" },
            { "type": "text", "text": "help" }, { "type": "expectBlock", "subflow": "qualify_service", "block": "ask_age" }, { "type": "processEffects" },
            { "type": "advanceClock", "milliseconds": 300000 }, { "type": "processEffects" }, { "type": "expectBlock", "subflow": "qualify_service", "block": "timed_out" }, { "type": "expectNoPendingWork" }
          ]
        },
        {
          "key": "alias_choice",
          "description": "A button alias is a specific source route, not a generated callback ID.",
          "steps": [
            { "type": "start" }, { "type": "text", "text": "консультация" }, { "type": "expectBlock", "block": "service_selected" }, { "type": "processEffects" }, { "type": "expectNoPendingWork" }
          ]
        },
        {
          "key": "input_exhausted",
          "description": "Two invalid typed replies take the bounded exhausted route.",
          "steps": [
            { "type": "start" }, { "type": "button", "block": "menu", "actionIndex": 0, "buttonIndex": 0 }, { "type": "text", "text": "continue" }, { "type": "expectBlock", "subflow": "qualify_service", "block": "ask_age" }, { "type": "processEffects" },
            { "type": "text", "text": "not-a-number" }, { "type": "expectBlock", "subflow": "qualify_service", "block": "ask_age" }, { "type": "processEffects" },
            { "type": "text", "text": "still-not-a-number" }, { "type": "expectBlock", "subflow": "qualify_service", "block": "exhausted" }, { "type": "processEffects" }, { "type": "expectNoPendingWork" }
          ]
        }
      ]
    },
    "qualification": {
      "contractVersion": 1,
      "qualificationKey": "lead-application-v1",
      "requirements": [
        { "id": "qualified_application", "scenarioKey": "qualified_application", "requiredAssertions": [{ "type": "assert_no_pending_work", "match": {} }] },
        { "id": "review_application", "scenarioKey": "ruleset_default_review", "requiredAssertions": [{ "type": "assert_no_pending_work", "match": {} }] }
      ]
    }
  }
}
