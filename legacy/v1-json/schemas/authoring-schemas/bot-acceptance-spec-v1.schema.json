{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saydone:authoring:bot-acceptance-spec-v1",
  "title": "BotAcceptanceSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptanceVersion",
    "scenarios"
  ],
  "properties": {
    "acceptanceVersion": {
      "const": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "initialContext": {
            "type": "object"
          },
          "allowFutureSchedules": {
            "type": "boolean"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "start"
                    },
                    "payload": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-zA-Z0-9_-]+$"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "command"
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "required": [
                    "type",
                    "command"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "contact"
                    },
                    "phone": {
                      "type": "string",
                      "pattern": "^\\+?[1-9][0-9]{6,14}$"
                    }
                  },
                  "required": [
                    "type",
                    "phone"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "button"
                    },
                    "subflow": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "block": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "actionIndex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "buttonIndex": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "type",
                    "block",
                    "actionIndex",
                    "buttonIndex"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "event"
                    },
                    "event": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    }
                  },
                  "required": [
                    "type",
                    "event"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "scheduledEvent"
                    },
                    "subflow": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "block": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "actionIndex": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "type",
                    "block",
                    "actionIndex"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "processEffects"
                    },
                    "maxEffects": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "advanceClock"
                    },
                    "milliseconds": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "type",
                    "milliseconds"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "restart"
                    },
                    "mode": {
                      "enum": [
                        "application",
                        "database"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "mode"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "expectBlock"
                    },
                    "subflow": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "block": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    }
                  },
                  "required": [
                    "type",
                    "block"
                  ]
                },
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "expectTransition"
                        },
                        "toSubflow": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": ".*\\S.*"
                        },
                        "toBlock": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": ".*\\S.*"
                        }
                      },
                      "required": [
                        "type",
                        "toBlock"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "expectTransition"
                        },
                        "toSubflow": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": ".*\\S.*"
                        },
                        "preservesState": {
                          "const": true
                        }
                      },
                      "required": [
                        "type",
                        "preservesState"
                      ]
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "expectContext"
                        },
                        "partial": {
                          "type": "object"
                        },
                        "exists": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": ".*\\S.*"
                          }
                        },
                        "absent": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": ".*\\S.*"
                          }
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    {
                      "anyOf": [
                        {
                          "required": [
                            "partial"
                          ]
                        },
                        {
                          "required": [
                            "exists"
                          ]
                        },
                        {
                          "required": [
                            "absent"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "expectMessage"
                    },
                    "subflow": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "block": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "actionIndex": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "type",
                    "block",
                    "actionIndex"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "expectEffects"
                    },
                    "actions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "subflow": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": ".*\\S.*"
                          },
                          "block": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": ".*\\S.*"
                          },
                          "actionIndex": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "block",
                          "actionIndex"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "actions"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "expectBusinessEvent"
                    },
                    "event": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "properties": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "type",
                    "event"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "expectSchedule"
                    },
                    "subflow": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "block": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    },
                    "actionIndex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "status": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": ".*\\S.*"
                    }
                  },
                  "required": [
                    "type",
                    "block",
                    "actionIndex"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "expectNoPendingWork"
                    },
                    "allowFutureSchedules": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "key",
          "description",
          "steps"
        ]
      }
    }
  }
}
