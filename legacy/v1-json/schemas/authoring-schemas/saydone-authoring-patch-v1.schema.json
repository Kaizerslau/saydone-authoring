{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saydone:authoring:saydone-authoring-patch-v1",
  "title": "SayDoneAuthoringPatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patchVersion",
    "baseRevision",
    "baseChecksum",
    "changes"
  ],
  "properties": {
    "patchVersion": {
      "const": 1
    },
    "baseRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "baseChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "replace_artifact"
              },
              "artifact": {
                "enum": [
                  "botSpec",
                  "dataFields",
                  "acceptance",
                  "qualification"
                ]
              },
              "value": {
                "type": "object"
              }
            },
            "required": [
              "type",
              "artifact",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "upsert_bot_spec_entry"
              },
              "section": {
                "enum": [
                  "assets",
                  "content",
                  "httpResources",
                  "blocks",
                  "subflows",
                  "ruleSets"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              },
              "value": {
                "type": "object"
              }
            },
            "required": [
              "type",
              "section",
              "key",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "remove_bot_spec_entry"
              },
              "section": {
                "enum": [
                  "assets",
                  "content",
                  "httpResources",
                  "blocks",
                  "subflows",
                  "ruleSets"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              }
            },
            "required": [
              "type",
              "section",
              "key"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "set_bot_spec_entry"
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              }
            },
            "required": [
              "type",
              "entry"
            ]
          }
        ]
      }
    }
  }
}
